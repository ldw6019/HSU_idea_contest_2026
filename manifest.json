{
  "manifest_version": 3,
  "name": "ON-Track",
  "version": "0.1.0",
  "description": "한성대 e클래스 안에서 과제·강의·비교과·시간표를 한눈에 보는 통합 학습 도우미 (프로토타입)",
  "permissions": ["storage"],
  "host_permissions": [
    "https://learn.hansung.ac.kr/*",
    "https://hsportal.hansung.ac.kr/*",
    "https://info.hansung.ac.kr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://learn.hansung.ac.kr/*"],
      "js": ["content/main.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/panel.css"],
      "matches": ["https://learn.hansung.ac.kr/*"]
    }
  ]
}
